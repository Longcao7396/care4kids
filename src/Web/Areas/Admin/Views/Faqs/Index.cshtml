@{
    ViewData["Title"] = "FAQs";
}
<div class="card">
    <div class="card-header"><h3 class="card-title">FAQs</h3></div>
    <div class="card-body" id="faqsBody">
        <div class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin"></i> Loading...</div>
    </div>
</div>
@section Scripts {
<script>
(async function() {
    try {
        const r = await fetch('/api/v1/faqs');
        if (!r.ok) throw new Error();
        const j = await r.json();
        document.getElementById('faqsBody').innerHTML = j.data?.length
            ? '<div class="alert alert-info">' + j.data.length + ' FAQ(s) found.</div>'
            : '<div class="alert alert-info">No FAQs found.</div>';
    } catch {
        document.getElementById('faqsBody').innerHTML = '<div class="alert alert-warning">FAQs data unavailable. API may not be implemented.</div>';
    }
})();
</script>
}
