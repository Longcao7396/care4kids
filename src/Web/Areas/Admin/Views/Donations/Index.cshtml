@{
    ViewData["Title"] = "Donations";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">All Donations</h3>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-4">
                <select class="form-control" id="filterStatus">
                    <option value="">All Statuses</option>
                    <option value="Confirmed">Confirmed</option>
                    <option value="Pending">Pending</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>
        </div>

        <table class="table table-bordered table-striped" id="donationsTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Donor</th>
                    <th>Campaign</th>
                    <th>Amount</th>
                    <th>Payment Method</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody id="donationsBody">
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        <i class="fas fa-spinner fa-spin"></i> Loading donations...
                    </td>
                </tr>
            </tbody>
        </table>

        <div id="paginationArea" class="mt-3"></div>
    </div>
</div>

@section Scripts {
<script>
let currentPage = 1;

async function loadDonations(page) {
    currentPage = page;
    const status = document.getElementById('filterStatus').value;

    try {
        const params = new URLSearchParams({ page, pageSize: 20 });
        if (status) params.append('status', status);

        const resp = await fetch('/api/v1/donations?' + params.toString(), {
            headers: { 'Authorization': 'Bearer ' + getJwtToken() }
        });

        if (!resp.ok) throw new Error();
        const json = await resp.json();
        renderDonations(json.data);
    } catch (e) {
        document.getElementById('donationsBody').innerHTML =
            '<tr><td colspan="7" class="text-center text-danger py-4">Failed to load donations. API may not be available.</td></tr>';
    }
}

function renderDonations(data) {
    const tbody = document.getElementById('donationsBody');
    const items = data?.items || [];

    if (!items.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">No donations found.</td></tr>';
        return;
    }

    tbody.innerHTML = items.map(d => \`
        <tr>
            <td>#\${d.donationId || d.id || '—'}</td>
            <td>\${d.isAnonymous ? '<em>Anonymous</em>' : escapeHtml(d.donorName || '—')}</td>
            <td>\${escapeHtml(d.campaignName || '—')}</td>
            <td><strong>$\${(d.amount || 0).toLocaleString()}</strong></td>
            <td>\${escapeHtml(d.paymentMethod || '—')}</td>
            <td><span class="badge badge-\${getStatusClass(d.status)}">\${d.status || '—'}</span></td>
            <td>\${formatDate(d.createdAt)}</td>
        </tr>\`).join('');

    renderPagination(data.page, data.totalPages);
}

function renderPagination(page, totalPages) {
    const area = document.getElementById('paginationArea');
    if (!totalPages || totalPages <= 1) { area.innerHTML = ''; return; }
    let html = '<nav><ul class="pagination justify-content-center">';
    for (let i = 1; i <= totalPages; i++) {
        html += \`<li class="page-item \${i === page ? 'active' : ''}">
            <a class="page-link" href="#" onclick="event.preventDefault(); loadDonations(\${i})">\${i}</a>
        </li>\`;
    }
    area.innerHTML = html + '</ul></nav>';
}

function getJwtToken() {
    const cookies = document.cookie.split('; ');
    const session = cookies.find(r => r.startsWith('GiveAID.Admin.Session='));
    return session ? session.split('=')[1] : '';
}

function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function formatDate(str) {
    return str ? new Date(str).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : '—';
}

function getStatusClass(status) {
    switch (status?.toLowerCase()) {
        case 'confirmed': return 'success';
        case 'pending': return 'warning';
        case 'cancelled': return 'danger';
        default: return 'secondary';
    }
}

$(function() { loadDonations(1); });
</script>
}
