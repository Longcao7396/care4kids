@{
    ViewData["Title"] = "Edit Cause";
}

@model CauseViewModel

<div class="card card-warning">
    <div class="card-header"><h3 class="card-title">Edit Cause</h3></div>
    <form method="post" asp-area="Admin" asp-controller="Causes" asp-action="Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="CauseId" value="@Model.CauseId" />
        <div class="card-body">
            <div class="form-group">
                <label>Cause Name *</label>
                <input type="text" name="Name" class="form-control" required value="@Model.Name">
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Sort Order</label>
                        <input type="number" name="SortOrder" class="form-control" value="@Model.SortOrder">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Active</label>
                        <div class="mt-2">
                            <input type="checkbox" name="IsActive" value="true" checked="@Model.IsActive">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-warning"><i class="fas fa-save"></i> Save</button>
            <a asp-area="Admin" asp-controller="Causes" asp-action="Index" class="btn btn-default float-right">Cancel</a>
        </div>
    </form>
</div>
