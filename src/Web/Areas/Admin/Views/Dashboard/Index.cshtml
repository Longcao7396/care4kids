@{
    ViewData["Title"] = "Dashboard";
    var stats = ViewData["Stats"];
    var overview = ViewData["Overview"] as dynamic;
}

<div class="row">
    <!-- Total Users -->
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3 id="statUsers">--</h3>
                <p>Total Users</p>
            </div>
            <div class="icon"><i class="fas fa-users"></i></div>
            <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>

    <!-- Total Causes -->
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3 id="statCauses">--</h3>
                <p>Total Causes</p>
            </div>
            <div class="icon"><i class="fas fa-heart"></i></div>
            <a asp-area="Admin" asp-controller="Causes" asp-action="Index" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>

    <!-- Total Campaigns -->
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3 id="statCampaigns">--</h3>
                <p>Total Campaigns</p>
            </div>
            <div class="icon"><i class="fas fa-bullhorn"></i></div>
            <a asp-area="Admin" asp-controller="Campaigns" asp-action="Index" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>

    <!-- Total Donations -->
    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3 id="statDonations">--</h3>
                <p>Total Donations</p>
            </div>
            <div class="icon"><i class="fas fa-donate"></i></div>
            <a asp-area="Admin" asp-controller="Donations" asp-action="Index" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
</div>

<div class="row">
    <!-- Donations Chart -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-chart-line mr-1"></i>Donations (Last 30 Days)</h3>
            </div>
            <div class="card-body">
                <canvas id="donationsChart" height="200"></canvas>
            </div>
        </div>
    </div>

    <!-- Cause Breakdown -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-chart-pie mr-1"></i>Donation Status</h3>
            </div>
            <div class="card-body">
                <canvas id="statusChart" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Donations Table -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-list mr-1"></i>Recent Donations</h3>
        <div class="card-tools">
            <a asp-area="Admin" asp-controller="Donations" asp-action="Index" class="btn btn-tool btn-sm">
                <i class="fas fa-external-link-alt"></i> View All
            </a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover text-nowrap">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Donor</th>
                    <th>Campaign</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody id="recentDonationsBody">
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        <i class="fas fa-spinner fa-spin"></i> Loading...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(async function() {
    // Placeholder chart data (API not implemented yet)
    const donationsChart = new Chart(document.getElementById('donationsChart'), {
        type: 'line',
        data: {
            labels: ['Day 1', 'Day 7', 'Day 14', 'Day 21', 'Day 28'],
            datasets: [{
                label: 'Donations ($)',
                data: [1200, 1900, 3000, 5000, 4000],
                borderColor: '#28a745',
                backgroundColor: 'rgba(40, 167, 69, 0.1)',
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: true } },
            scales: { y: { beginAtZero: true } }
        }
    });

    const statusChart = new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
            labels: ['Confirmed', 'Pending', 'Cancelled'],
            datasets: [{
                data: [65, 25, 10],
                backgroundColor: ['#28a745', '#ffc107', '#dc3545']
            }]
        },
        options: { responsive: true }
    });

    // Try to load real data from API
    try {
        // Dashboard stats placeholder
        document.getElementById('statUsers').textContent = '—';
        document.getElementById('statCauses').textContent = '—';
        document.getElementById('statCampaigns').textContent = '—';
        document.getElementById('statDonations').textContent = '—';

        // Try loading recent donations
        const resp = await fetch('/api/v1/admin/recent-donations?count=10', {
            headers: { 'Authorization': 'Bearer ' + getJwtToken() }
        });
        if (resp.ok) {
            const json = await resp.json();
            renderDonations(json.data || []);
        }
    } catch (e) {
        document.getElementById('recentDonationsBody').innerHTML =
            '<tr><td colspan="6" class="text-center text-muted py-4">API not available — data will populate once API is implemented</td></tr>';
    }
})();

function getJwtToken() {
    const val = document.cookie.split('; ').find(r => r.startsWith('GiveAID.Admin.Session'));
    return val ? val.split('=')[1] : '';
}

function renderDonations(donations) {
    const tbody = document.getElementById('recentDonationsBody');
    if (!donations || donations.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No donations found</td></tr>';
        return;
    }
    tbody.innerHTML = donations.map(d => \`
        <tr>
            <td>#\${d.donationId || d.id || '—'}</td>
            <td>\${d.donorName || 'Anonymous'}</td>
            <td>\${d.campaignName || '—'}</td>
            <td>$\${(d.amount || 0).toLocaleString()}</td>
            <td><span class="badge badge-\${getStatusClass(d.status)}">\${d.status || '—'}</span></td>
            <td>\${formatDate(d.createdAt)}</td>
        </tr>
    \`).join('');
}

function getStatusClass(status) {
    switch (status?.toLowerCase()) {
        case 'confirmed': return 'success';
        case 'pending': return 'warning';
        case 'cancelled': return 'danger';
        default: return 'secondary';
    }
}

function formatDate(dateStr) {
    if (!dateStr) return '—';
    return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
</script>
}
