@{
    ViewData["Title"] = "Access Denied";
}

<div class="card">
    <div class="card-body">
        <div class="text-center">
            <i class="fas fa-lock fa-3x text-danger mb-3"></i>
            <h3>Access Denied</h3>
            <p class="text-muted">You do not have permission to access this page.</p>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Go to Dashboard</a>
            <a asp-area="Admin" asp-controller="Auth" asp-action="Login" class="btn btn-outline-secondary">Login Again</a>
        </div>
    </div>
</div>
