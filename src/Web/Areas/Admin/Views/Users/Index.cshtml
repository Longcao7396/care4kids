@{
    ViewData["Title"] = "Users";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">All Users</h3>
        <div class="card-tools">
            <a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn btn-success btn-sm">
                <i class="fas fa-plus"></i> Add User
            </a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        <div id="usersBody" class="p-3 text-center text-muted">
            <i class="fas fa-spinner fa-spin"></i> Loading...
        </div>
    </div>
</div>

@section Scripts {
<script>
(async function() {
    try {
        const resp = await fetch('/api/v1/users', {
            headers: { 'Authorization': 'Bearer ' + getJwt() }
        });
        if (!resp.ok) throw new Error();
        const json = await resp.json();
        renderUsers(json.data?.items || json.data || []);
    } catch {
        document.getElementById('usersBody').innerHTML = '<div class="alert alert-warning">Users data unavailable. API may not be implemented.</div>';
    }
})();

function renderUsers(users) {
    if (!users.length) {
        document.getElementById('usersBody').innerHTML = '<div class="alert alert-info">No users found.</div>';
        return;
    }
    const html = '<table class="table table-bordered table-striped"><thead><tr><th>ID</th><th>Username</th><th>Email</th><th>Role</th><th>Active</th><th>Joined</th><th>Actions</th></tr></thead><tbody>' +
        users.map(u => \`<tr>
            <td>#\${u.userId || u.id}</td>
            <td>\${escapeHtml(u.username || '')}</td>
            <td>\${escapeHtml(u.email || '')}</td>
            <td><span class="badge badge-info">\${u.role || 'User'}</span></td>
            <td>\${u.isActive ? '<span class="badge badge-success">Yes</span>' : '<span class="badge badge-secondary">No</span>'}</td>
            <td>\${formatDate(u.createdAt)}</td>
            <td>
                <a href="/Admin/Users/Edit/\${u.userId || u.id}" class="btn btn-xs btn-warning"><i class="fas fa-edit"></i></a>
            </td>
        </tr>\`).join('') + '</tbody></table>';
    document.getElementById('usersBody').innerHTML = html;
}
function getJwt() {
    const c = document.cookie.split('; ').find(r => r.startsWith('GiveAID.Admin.Session='));
    return c ? c.split('=')[1] : '';
}
function escapeHtml(s) { return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function formatDate(s) { return s ? new Date(s).toLocaleDateString() : '—'; }
</script>
}
