@{
    ViewData["Title"] = "Settings";
}

@inject Microsoft.Extensions.Hosting.IHostEnvironment HostEnv
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<div class="card">
    <div class="card-header"><h3 class="card-title">Settings</h3></div>
    <div class="card-body">
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            Settings management will be available in a future update.
        </div>
        <div class="row mt-3">
            <div class="col-md-6">
                <div class="card card-secondary">
                    <div class="card-header"><h3 class="card-title">General</h3></div>
                    <div class="card-body">
                        <dl>
                            <dt>Application Name</dt><dd>GiveAID</dd>
                            <dt>Version</dt><dd>2.0</dd>
                            <dt>Environment</dt><dd>@HostEnv.EnvironmentName</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card card-secondary">
                    <div class="card-header"><h3 class="card-title">API Connection</h3></div>
                    <div class="card-body">
                        <dl>
                            <dt>API Base URL</dt><dd>@Config["Api:BaseUrl"]</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
