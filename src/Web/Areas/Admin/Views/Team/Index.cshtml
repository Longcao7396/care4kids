@{
    ViewData["Title"] = "Team";
}
<div class="card">
    <div class="card-header"><h3 class="card-title">Team Members</h3></div>
    <div class="card-body" id="teamBody">
        <div class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin"></i> Loading...</div>
    </div>
</div>
@section Scripts {
<script>
(async function() {
    try {
        const r = await fetch('/api/v1/team');
        if (!r.ok) throw new Error();
        const j = await r.json();
        document.getElementById('teamBody').innerHTML = j.data?.length
            ? '<div class="alert alert-info">' + j.data.length + ' team member(s) found.</div>'
            : '<div class="alert alert-info">No team members found.</div>';
    } catch {
        document.getElementById('teamBody').innerHTML = '<div class="alert alert-warning">Team data unavailable. API may not be implemented.</div>';
    }
})();
</script>
}
