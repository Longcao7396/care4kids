@{
    ViewData["Title"] = "Gallery";
}
<div class="card">
    <div class="card-header"><h3 class="card-title">Gallery</h3></div>
    <div class="card-body" id="galleryBody">
        <div class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin"></i> Loading...</div>
    </div>
</div>
@section Scripts {
<script>
(async function() {
    try {
        const r = await fetch('/api/v1/gallery');
        if (!r.ok) throw new Error();
        const j = await r.json();
        document.getElementById('galleryBody').innerHTML = j.data?.length
            ? '<div class="alert alert-info">' + j.data.length + ' gallery item(s) found.</div>'
            : '<div class="alert alert-info">No gallery items found.</div>';
    } catch {
        document.getElementById('galleryBody').innerHTML = '<div class="alert alert-warning">Gallery data unavailable. API may not be implemented.</div>';
    }
})();
</script>
}
