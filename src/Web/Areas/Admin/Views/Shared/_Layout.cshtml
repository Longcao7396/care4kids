<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>@ViewData["Title"] - GiveAID Admin</title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- AdminLTE 3.2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/css/adminlte.min.css">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link">Home</a>
                </li>
            </ul>

            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Auth" asp-action="Logout">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="brand-link">
                <img src="https://via.placeholder.com/33x33/28a745/ffffff?text=GA" alt="GiveAID Logo" class="brand-image img-circle elevation-3" style="opacity:.8">
                <span class="brand-text font-weight-light">GiveAID</span>
            </a>

            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sidebar user panel -->
                <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                    <div class="image">
                        <img src="https://via.placeholder.com/160x160/6c757d/ffffff?text=Admin" class="img-circle elevation-2" alt="User Image">
                    </div>
                    <div class="info">
                        <a href="#" class="d-block">@Context.Session.GetString("FullName")</a>
                        <small class="text-white-50">@Context.Session.GetString("Role")</small>
                    </div>
                </div>

                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-header">MAIN</li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>

                        <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Causes" ? "menu-open" : "")">
                            <a href="#" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Causes" ? "active" : "")">
                                <i class="nav-icon fas fa-heart"></i>
                                <p>Causes <i class="right fas fa-angle-left"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Causes" asp-action="Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>All Causes</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Causes" asp-action="Create" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Add New</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Campaigns" ? "menu-open" : "")">
                            <a href="#" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Campaigns" ? "active" : "")">
                                <i class="nav-icon fas fa-bullhorn"></i>
                                <p>Campaigns <i class="right fas fa-angle-left"></i></p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Campaigns" asp-action="Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>All Campaigns</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Admin" asp-controller="Campaigns" asp-action="Create" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>Add New</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="CampaignReports" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CampaignReports" ? "active" : "")">
                                <i class="nav-icon fas fa-chart-line"></i>
                                <p>Campaign Reports</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Donations" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Donations" ? "active" : "")">
                                <i class="nav-icon fas fa-donate"></i>
                                <p>Donations</p>
                            </a>
                        </li>

                        <li class="nav-header">MANAGEMENT</li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Users</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Organizations" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Organizations" ? "active" : "")">
                                <i class="nav-icon fas fa-building"></i>
                                <p>Organizations</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Team" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Team" ? "active" : "")">
                                <i class="nav-icon fas fa-user-friends"></i>
                                <p>Team</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Achievements" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Achievements" ? "active" : "")">
                                <i class="nav-icon fas fa-trophy"></i>
                                <p>Achievements</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Gallery" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Gallery" ? "active" : "")">
                                <i class="nav-icon fas fa-images"></i>
                                <p>Gallery</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Careers" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Careers" ? "active" : "")">
                                <i class="nav-icon fas fa-briefcase"></i>
                                <p>Careers</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Faqs" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Faqs" ? "active" : "")">
                                <i class="nav-icon fas fa-question-circle"></i>
                                <p>FAQs</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Conversations" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Conversations" ? "active" : "")">
                                <i class="nav-icon fas fa-comments"></i>
                                <p>Conversations</p>
                            </a>
                        </li>

                        <li class="nav-header">SYSTEM</li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="CmsPages" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CmsPages" ? "active" : "")">
                                <i class="nav-icon fas fa-file-alt"></i>
                                <p>CMS Pages</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="EmailLogs" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "EmailLogs" ? "active" : "")">
                                <i class="nav-icon fas fa-envelope"></i>
                                <p>Email Logs</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Settings" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")">
                                <i class="nav-icon fas fa-cog"></i>
                                <p>Settings</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper">
            <!-- Content Header -->
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0">@ViewData["Title"]</h1>
                        </div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-right">
                                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Home</a></li>
                                @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Dashboard")
                                {
                                    <li class="breadcrumb-item">@ViewContext.RouteData.Values["controller"]</li>
                                }
                                @if (ViewContext.RouteData.Values["action"]?.ToString() != "Index")
                                {
                                    <li class="breadcrumb-item active">@ViewContext.RouteData.Values["action"]</li>
                                }
                            </ol>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <section class="content">
                <div class="container-fluid">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible">
                            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                            <h5><i class="icon fas fa-check"></i> Success</h5>
                            @TempData["Success"]
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible">
                            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                            <h5><i class="icon fas fa-ban"></i> Error</h5>
                            @TempData["Error"]
                        </div>
                    }

                    @RenderBody()
                </div>
            </section>
        </div>

        <!-- Footer -->
        <footer class="main-footer">
            <div class="float-right d-none d-sm-inline-block">
                <strong>GiveAID Admin</strong> &copy; 2026
            </div>
        </footer>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap 4 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2.0/dist/js/adminlte.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
