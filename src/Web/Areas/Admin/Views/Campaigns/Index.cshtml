@{
    ViewData["Title"] = "Campaigns";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">All Campaigns</h3>
        <div class="card-tools">
            <a asp-area="Admin" asp-controller="Campaigns" asp-action="Create" class="btn btn-success btn-sm">
                <i class="fas fa-plus"></i> Add New Campaign
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <div class="row">
                <div class="col-md-3">
                    <select class="form-control" id="filterStatus">
                        <option value="">All Statuses</option>
                        <option value="Active">Active</option>
                        <option value="Draft">Draft</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <input type="text" class="form-control" id="searchInput" placeholder="Search campaigns...">
                </div>
                <div class="col-md-3">
                    <button class="btn btn-secondary btn-block" onclick="loadCampaigns(1)">
                        <i class="fas fa-search"></i> Filter
                    </button>
                </div>
            </div>
        </div>

        <table class="table table-bordered table-striped" id="campaignsTable">
            <thead>
                <tr>
                    <th style="width:40px">ID</th>
                    <th>Name</th>
                    <th>Cause</th>
                    <th>Goal</th>
                    <th>Raised</th>
                    <th>Progress</th>
                    <th>Status</th>
                    <th>Featured</th>
                    <th style="width:160px">Actions</th>
                </tr>
            </thead>
            <tbody id="campaignsBody">
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">
                        <i class="fas fa-spinner fa-spin"></i> Loading campaigns...
                    </td>
                </tr>
            </tbody>
        </table>

        <div id="paginationArea" class="mt-3"></div>
    </div>
</div>

@section Scripts {
<script>
let currentPage = 1;

async function loadCampaigns(page) {
    currentPage = page;
    const status = document.getElementById('filterStatus').value;
    const search = document.getElementById('searchInput').value;

    try {
        const params = new URLSearchParams({ page, pageSize: 20 });
        if (status) params.append('status', status);
        if (search) params.append('search', search);

        const resp = await fetch('/api/v1/campaigns?' + params.toString(), {
            headers: { 'Authorization': 'Bearer ' + getJwtToken() }
        });

        if (!resp.ok) throw new Error('API error');
        const json = await resp.json();
        renderCampaigns(json.data);
    } catch (e) {
        document.getElementById('campaignsBody').innerHTML =
            '<tr><td colspan="9" class="text-center text-danger py-4">Failed to load campaigns. API may not be available.</td></tr>';
    }
}

function renderCampaigns(data) {
    const tbody = document.getElementById('campaignsBody');
    const items = data?.items || [];

    if (!items.length) {
        tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-4">No campaigns found.</td></tr>';
        return;
    }

    tbody.innerHTML = items.map(c => {
        const progress = c.goalAmount > 0 ? Math.min(100, Math.round((c.raisedAmount / c.goalAmount) * 100)) : 0;
        return \`
        <tr>
            <td>#\${c.campaignId}</td>
            <td>
                <strong>\${escapeHtml(c.name)}</strong>
            </td>
            <td>\${escapeHtml(c.causeName || '—')}</td>
            <td>$\${(c.goalAmount || 0).toLocaleString()}</td>
            <td>$\${(c.raisedAmount || 0).toLocaleString()}</td>
            <td>
                <div class="progress mb-0" style="height:20px">
                    <div class="progress-bar bg-success" style="width:\${progress}%">\${progress}%</div>
                </div>
            </td>
            <td><span class="badge badge-\${getStatusClass(c.status)}">\${c.status || '—'}</span></td>
            <td>\${c.isFeatured ? '<span class="badge badge-primary">Yes</span>' : '<span class="badge badge-secondary">No</span>'}</td>
            <td>
                <a asp-area="Admin" asp-controller="Campaigns" asp-action="Details" asp-route-id="\${c.campaignId}"
                   class="btn btn-xs btn-info" title="View">
                    <i class="fas fa-eye"></i>
                </a>
                <a asp-area="Admin" asp-controller="Campaigns" asp-action="Edit" asp-route-id="\${c.campaignId}"
                   class="btn btn-xs btn-warning" title="Edit">
                    <i class="fas fa-edit"></i>
                </a>
                <form asp-area="Admin" asp-controller="Campaigns" asp-action="Delete" asp-route-id="\${c.campaignId}"
                      method="post" style="display:inline" onsubmit="return confirmDelete(this)">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-xs btn-danger" title="Delete">
                        <i class="fas fa-trash"></i>
                    </button>
                </form>
            </td>
        </tr>\`;
    }).join('');

    // Render pagination
    renderPagination(data.page, data.totalPages);
}

function renderPagination(page, totalPages) {
    const area = document.getElementById('paginationArea');
    if (!totalPages || totalPages <= 1) { area.innerHTML = ''; return; }

    let html = '<nav><ul class="pagination justify-content-center">';
    for (let i = 1; i <= totalPages; i++) {
        html += \`<li class="page-item \${i === page ? 'active' : ''}">
            <a class="page-link" href="#" onclick="event.preventDefault(); loadCampaigns(\${i})">\${i}</a>
        </li>\`;
    }
    html += '</ul></nav>';
    area.innerHTML = html;
}

function confirmDelete(form) {
    return confirm('Are you sure you want to delete this campaign?');
}

function getJwtToken() {
    const cookies = document.cookie.split('; ');
    const session = cookies.find(r => r.startsWith('GiveAID.Admin.Session='));
    return session ? session.split('=')[1] : '';
}

function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function getStatusClass(status) {
    switch (status?.toLowerCase()) {
        case 'active': return 'success';
        case 'draft': return 'secondary';
        case 'completed': return 'info';
        case 'cancelled': return 'danger';
        default: return 'secondary';
    }
}

// Load on page ready
$(function() { loadCampaigns(1); });
</script>
}
