@{
    ViewData["Title"] = "Organizations";
}
<div class="card">
    <div class="card-header"><h3 class="card-title">Organizations</h3></div>
    <div class="card-body" id="orgsBody">
        <div class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin"></i> Loading...</div>
    </div>
</div>
@section Scripts {
<script>
(async function() {
    try {
        const r = await fetch('/api/v1/organizations', { headers: { 'Authorization': 'Bearer ' + getJwt() } });
        if (!r.ok) throw new Error();
        const j = await r.json();
        document.getElementById('orgsBody').innerHTML = j.data?.length
            ? '<div class="alert alert-info">' + j.data.length + ' organization(s) found.</div>'
            : '<div class="alert alert-info">No organizations found.</div>';
    } catch {
        document.getElementById('orgsBody').innerHTML = '<div class="alert alert-warning">Organizations data unavailable. API may not be implemented.</div>';
    }
})();
function getJwt() { const c = document.cookie.split('; ').find(r => r.startsWith('GiveAID.Admin.Session=')); return c ? c.split('=')[1] : ''; }
</script>
}
