{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "BaseUrl": "http://localhost:5000"
  },
  "Admin": {
    "CookieName": "GiveAID.Admin",
    "SessionTimeoutHours": 8
  },
  "ConnectionStrings": {
    // ─────────────────────────────────────────────────────────────────────────
    // Admin (Web) project talks to the SAME database as WebApi.
    // Local dev defaults to (localdb)\MSSQLLocalDB — ships with Visual Studio.
    // Override per environment with the ConnectionStrings__DefaultConnection env var.
    // ─────────────────────────────────────────────────────────────────────────
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=GiveAIDDB;Integrated Security=True;MultipleActiveResultSets=True;TrustServerCertificate=True;Connect Timeout=15"
  }
}
