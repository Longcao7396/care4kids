{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": ""  // Override in appsettings.Development.json (gitignored) or set the Jwt__Secret env var
  },

  "Jwt": {
    // IMPORTANT: In production, set Jwt__Secret environment variable or use Azure Key Vault / AWS Secrets Manager.
    // The secret MUST be at least 32 characters long.
    // DO NOT commit a real secret to source control.
    // Current value is intentionally blank — the app WILL REFUSE TO START in production
    // if the Jwt__Secret environment variable is not set.
    // For local development only: set Jwt__Secret in appsettings.Development.json or
    // export Jwt__Secret="your-32-char-minimum-secret" before running.
    "Secret": "",
    "Issuer": "GiveAID.V2",
    "Audience": "GiveAID.V2.Client",
    "ExpiryMinutes": 1440
  },

  "Smtp": {
    "SmtpEnabled": false,
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "FromEmail": "no-reply@giveaid.org",
    "FromName": "GiveAID",
    // M-14: Email retry configuration
    "MaxRetries": 3,
    "RetryDelaySeconds": 2
  },

  "PaymentGateway": {
    "Type": "Mock",
    "StripeSecretKey": "",
    "StripeWebhookSecret": ""
  },

  "Cors": {
    "AllowedOrigins": "http://localhost:3000,http://localhost:3001"
  },

  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },

  "SeedData": {
    "Enabled": true,
    "Required": false
  },

  // M-06 & M-08: Configurable business rules
  "App": {
    "MaxDonationAmount": 1000000.00,
    "MinDonationAmount": 1.00,
    "MaxAdminPageSize": 100
  },

  // Image storage (Cloudinary)
  // Required env vars: CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
  // For production: set environment variables (preferred) or fill in values below (gitignored)
  // Free tier: 25 credits/month (~2500 uploads). Sign up at https://cloudinary.com
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": "",
    "UploadFolder": "giveaid"
  }
}
