# Override API base URL for local development.
# Default in src/config.js is https://localhost:44300/api (matches IIS Express default).
# Uncomment the line below to point at a different backend.

# REACT_APP_API_URL=https://localhost:44300/api
# REACT_APP_API_URL=http://localhost:44300/api
# REACT_APP_API_URL=http://localhost:5000/api

# After editing, restart `npm start` so the new value is picked up by webpack.
