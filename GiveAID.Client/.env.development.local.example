# Override API base URL for local development.
# Default in src/config.js is http://localhost:5231/api/v1 (matches v2 backend --urls).
# Uncomment the line below to point at a different backend.

# REACT_APP_API_URL=http://localhost:5231/api/v1
# REACT_APP_PROXY_TARGET=http://localhost:5231

# After editing, restart `npm start` so the new value is picked up by webpack.
